          "queryText": "SELECT category, COUNT(*) AS complaints, SUM(sla_breached) AS breached, ROUND(100.0 * SUM(sla_breached) / COUNT(*), 1) AS breach_pct FROM complaints GROUP BY category ORDER BY breach_pct DESC, complaints DESC",

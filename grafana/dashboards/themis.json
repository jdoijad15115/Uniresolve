    {
      "id": 9,
      "type": "table",
      "title": "Systemic patterns: complaints sharing a cluster",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "themis-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,

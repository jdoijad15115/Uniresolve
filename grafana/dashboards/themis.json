      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "themis-sqlite"
          },
          "queryType": "table",
          "queryText": "SELECT MIN(category) AS category, COUNT(*) AS complaints, COUNT(DISTINCT customer_id) AS customers, COUNT(DISTINCT channel) AS channels, SUM(sla_breached) AS sla_breached, MIN(substr(received_at,1,10)) AS first_seen FROM complaints WHERE cluster_id IS NOT NULL GROUP BY cluster_id HAVING COUNT(*) >= 2 ORDER BY customers DESC, complaints DESC",
          "rawQueryText": "SELECT MIN(category) AS category, COUNT(*) AS complaints, COUNT(DISTINCT customer_id) AS customers, COUNT(DISTINCT channel) AS channels, SUM(sla_breached) AS sla_breached, MIN(substr(received_at,1,10)) AS first_seen FROM complaints WHERE cluster_id IS NOT NULL GROUP BY cluster_id HAVING COUNT(*) >= 2 ORDER BY customers DESC, complaints DESC",
